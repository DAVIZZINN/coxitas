{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": { "maxDuration": 15 }
  },
  "redirects": [
    { "source": "/admin", "destination": "/admin/", "permanent": true },
    { "source": "/pedido", "destination": "/pedido/", "permanent": true },
    { "source": "/(lib|banco|ferramentas|supabase|node_modules)/(.*)", "destination": "/", "permanent": false },
    { "source": "/(package.json|package-lock.json|vercel.json|.gitignore|.vercelignore)", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/publico/:acao", "destination": "/api/publico?acao=:acao" },
    { "source": "/api/admin/:acao", "destination": "/api/admin?acao=:acao" },
    { "source": "/api/auth/:acao", "destination": "/api/auth?acao=:acao" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()" }
      ]
    },
    {
      "source": "/((?!admin|api/).*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-dNMJu/ZEU4cjlC07HvAKgfPX9Fx0Pk8LDvX8zjz09YM=' 'sha256-oIqSSULU/s4rnBNJolcckNp7xVSNjUcKniPqJOPnnrw='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self'; frame-src https://www.google.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; object-src 'none'; frame-ancestors 'none'" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(img|video)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/assets/:arquivo([^/]+)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ]
}
